# Runtime
GLAZZ_ENV=development
API_PORT=8080
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Durable and ephemeral stores (used from M2 onward)
DATABASE_URL=postgres://glazz:glazz@localhost:5432/glazz?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# Authentication
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=glazz-web
JWT_PRIVATE_KEY_PATH=
BOOTSTRAP_ADMIN_EMAILS=

# Development LLM provider. OpenCode Go is not the production provider.
LLM_PROVIDER_KIND=openai-compatible
LLM_PROVIDER_BASE_URL=https://opencode.ai/zen/go/v1
LLM_PROVIDER_API_KEY=
LLM_DEFAULT_MODEL=deepseek-v4-flash

# Temporary compatibility aliases for the development provider only.
# API_URL=
# API_KEY=
