# Runtime
GLAZZ_ENV=development
API_PORT=8080
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Durable and ephemeral stores (used from M2 onward)
DATABASE_URL=postgres://glazz:glazz@localhost:5432/glazz?sslmode=disable
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_MAX_LIFETIME=1h
DATABASE_MAX_IDLE_TIME=30m
DATABASE_HEALTH_TIMEOUT=2s
DATABASE_MIGRATE_ON_STARTUP=true
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=glazz
REDIS_HEALTH_TIMEOUT=2s

# HTTP runtime
SHUTDOWN_TIMEOUT=10s
HTTP_REQUEST_TIMEOUT=30s
HTTP_MAX_BODY_BYTES=1048576
MAINTENANCE_MODE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_CIDRS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
# Deterministic OAuth is forbidden in production and intended only for E2E.
OAUTH_TEST_MODE=false
OAUTH_TEST_EMAIL=

# Authentication
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=glazz-web
JWT_ACTIVE_KID=local-1
JWT_PRIVATE_KEY_PATH=
JWT_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_RECENT_TTL=15m
GUEST_SESSION_TTL=720h
# Generate locally with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
COOKIE_SIGNING_KEY=
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TERMS_VERSION=2026-07-23
PRIVACY_VERSION=2026-07-23
BOOTSTRAP_ADMIN_EMAILS=

# Telemetry
OTEL_SERVICE_NAME=glazz-api
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_PATH=/metrics

# The fake provider is the safe default. OpenCode Go is development-only.
LLM_PROVIDER_KIND=fake
LLM_PROVIDER_BASE_URL=
LLM_PROVIDER_API_KEY=
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_FAKE_OUTPUT_TOKENS=6

# Temporary compatibility aliases for the development provider only.
# API_URL=
# API_KEY=
