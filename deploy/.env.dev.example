# Compose
COMPOSE_PROJECT_NAME=glazz
GLAZZ_COMPOSE_ENV_FILE=.env

# Local published ports
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8080
WEB_HOST_PORT=3000

# PostgreSQL
POSTGRES_DB=glazz
POSTGRES_USER=glazz
# Local-only example secret. Replace it in deploy/.env.
POSTGRES_PASSWORD=local-glazz
DATABASE_URL=postgres://glazz:local-glazz@postgres:5432/glazz?sslmode=disable
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_MAX_LIFETIME=1h
DATABASE_MAX_IDLE_TIME=30m
DATABASE_HEALTH_TIMEOUT=2s
DATABASE_MIGRATE_ON_STARTUP=false

# Redis
REDIS_APPENDONLY=no
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=glazz
REDIS_HEALTH_TIMEOUT=2s

# Runtime and HTTP
GLAZZ_ENV=development
API_PORT=8080
WEB_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
SHUTDOWN_TIMEOUT=10s
HTTP_REQUEST_TIMEOUT=30s
HTTP_MAX_BODY_BYTES=1048576
MAINTENANCE_MODE=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
TRUSTED_PROXY_CIDRS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:8080/api/v1/auth/google/callback
OAUTH_TEST_MODE=false
OAUTH_TEST_EMAIL=

# Authentication
JWT_ISSUER=http://127.0.0.1:8080
JWT_AUDIENCE=glazz-web
JWT_ACTIVE_KID=local-1
JWT_PRIVATE_KEY_PATH=
JWT_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_RECENT_TTL=15m
GUEST_SESSION_TTL=720h
# Local-only deterministic key; replace it outside disposable development.
COOKIE_SIGNING_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TERMS_VERSION=2026-07-23
PRIVACY_VERSION=2026-07-23
BOOTSTRAP_ADMIN_EMAILS=

# Telemetry
OTEL_SERVICE_NAME=glazz-api
API_OTEL_SERVICE_NAME=glazz-api
WORKER_OTEL_SERVICE_NAME=glazz-worker
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_PATH=/metrics

# LLM
LLM_PROVIDER_KIND=fake
LLM_PROVIDER_BASE_URL=
LLM_PROVIDER_API_KEY=
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_FAKE_OUTPUT_TOKENS=6
