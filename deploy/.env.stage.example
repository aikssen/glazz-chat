# Normal stage configuration. Empty secret values must be supplied by Dokploy
# or another secret manager; never commit the populated file.

# Compose
COMPOSE_PROJECT_NAME=glazz-stage
GLAZZ_COMPOSE_ENV_FILE=.env

# Resource limits
POSTGRES_MEMORY_LIMIT=768m
REDIS_MEMORY_LIMIT=128m
API_MEMORY_LIMIT=256m
WORKER_MEMORY_LIMIT=128m
WEB_MEMORY_LIMIT=512m

# PostgreSQL
POSTGRES_DB=glazz
POSTGRES_USER=glazz
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_MAX_LIFETIME=1h
DATABASE_MAX_IDLE_TIME=30m
DATABASE_HEALTH_TIMEOUT=2s
DATABASE_MIGRATE_ON_STARTUP=false

# Redis
REDIS_APPENDONLY=yes
REDIS_URL=
REDIS_PREFIX=glazz_stage
REDIS_HEALTH_TIMEOUT=2s

# Runtime and HTTP
GLAZZ_ENV=production
API_PORT=8080
WEB_URL=https://stage.glazz.example
NEXT_PUBLIC_API_URL=https://api.stage.glazz.example
SHUTDOWN_TIMEOUT=10s
HTTP_REQUEST_TIMEOUT=30s
HTTP_MAX_BODY_BYTES=1048576
MAINTENANCE_MODE=false
CORS_ALLOWED_ORIGINS=https://stage.glazz.example
TRUSTED_PROXY_CIDRS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.stage.glazz.example/api/v1/auth/google/callback
OAUTH_TEST_MODE=false
OAUTH_TEST_EMAIL=

# Authentication
JWT_ISSUER=https://api.stage.glazz.example
JWT_AUDIENCE=glazz-web
JWT_ACTIVE_KID=stage-1
JWT_PRIVATE_KEY_PATH=/run/secrets/glazz-jwt-private-key
JWT_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_RECENT_TTL=15m
GUEST_SESSION_TTL=720h
COOKIE_SIGNING_KEY=
COOKIE_DOMAIN=.stage.glazz.example
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TERMS_VERSION=2026-07-23
PRIVACY_VERSION=2026-07-23
BOOTSTRAP_ADMIN_EMAILS=

# Telemetry
OTEL_SERVICE_NAME=glazz-api
API_OTEL_SERVICE_NAME=glazz-api
WORKER_OTEL_SERVICE_NAME=glazz-worker
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_PATH=/metrics

# LLM
LLM_PROVIDER_KIND=openai-compatible
LLM_PROVIDER_BASE_URL=https://opencode.ai/zen/go/v1
LLM_PROVIDER_API_KEY=
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_FAKE_OUTPUT_TOKENS=6
